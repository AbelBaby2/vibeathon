# Bid2Work AI — Backend Environment Configuration Example
# Copy this file to .env for local development. Never commit real secrets.

APP_NAME="Bid2Work AI"
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Server binding
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document upload and processing safeguards
MAX_UPLOAD_SIZE_MB=25
MAX_BIDDER_FILES=10
MAX_PAGES_PER_PDF=200
TEMP_UPLOAD_DIR=/tmp/bid2work_uploads

# Lightweight SQLite database path for MVP audit trail records
SQLITE_DB_PATH=./data/bid2work_audit.db

# External LLM API Integration (OpenAI-compatible / configurable endpoint)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_llm_api_key_placeholder_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
